# Canonical OpenAI/LLM settings. LLM_API_KEY remains a compatibility fallback.
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=gpt-5.4-mini
LLM_REQUEST_TIMEOUT=60
LLM_STRUCTURED_API=auto
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

TAVILY_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_MAX_CONNECTION_POOL_SIZE=20
NEO4J_MAX_TRANSACTION_RETRY_TIME=30
NEO4J_FETCH_SIZE=1000

LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
LABEL_STUDIO_PROJECT_ID=
LABEL_STUDIO_TIMEOUT=20
LABEL_STUDIO_BATCH_SIZE=100
LABEL_STUDIO_MODEL_VERSION=
