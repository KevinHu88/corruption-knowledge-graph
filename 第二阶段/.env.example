# 第二阶段轻量参数。Neo4j/LLM 连接继续只读复用 ../第一阶段/.env。
QA_CHUNK_SIZE=800
QA_CHUNK_OVERLAP=100
QA_DOCUMENT_TOP_K=5
QA_RETRIEVAL_MODE=hybrid
QA_EMBEDDING_PROVIDER=hashing
QA_EMBEDDING_DIMENSIONS=384
QA_VECTOR_CANDIDATE_MULTIPLIER=4
QA_VECTOR_MIN_SCORE=0.10
QA_RERANK_BM25_WEIGHT=0.45
QA_RERANK_VECTOR_WEIGHT=0.45
QA_RERANK_COVERAGE_WEIGHT=0.10
QA_VECTOR_FAILURE_FALLBACK=true
QA_GRAPH_TOP_K=10
QA_GRAPH_PATH_MAX_HOPS=3
QA_GRAPH_PATH_CANDIDATE_LIMIT=100
QA_GRAPH_PATH_SIMILARITY_THRESHOLD=0.55
QA_FUSION_LIMIT=12
QA_MAX_CONTEXT_CHARS=12000

# FastAPI
QA_APP_NAME=Knowledge QA API
QA_APP_ENV=development
QA_HOST=127.0.0.1
QA_PORT=8000
QA_API_MODE=mock
QA_MAX_UPLOAD_SIZE=20971520
QA_ALLOWED_FILE_TYPES=.txt,.pdf,.docx
QA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
QA_QUESTION_MAX_CHARS=4000
